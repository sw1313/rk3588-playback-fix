+/* Standard Android P010: 16-bit little-endian samples, 10 significant bits.
+ * stride is the Y plane row increment in bytes, as reported by CCodec.
+ * Copy full samples; no quantization, color conversion or tone mapping. */
+static int mediacodec_copy_p010(AVCodecContext *avctx, MediaCodecDecContext *s,
+                               uint8_t *data, size_t capacity,
+                               FFAMediaCodecBufferInfo *info, AVFrame *frame)
+{
+    uint64_t yoff, uvoff, yend, uvend, end;
+    int width = avctx->width, height = avctx->height;
+    int uvbytes;
+    if (!data || !frame->data[0] || !frame->data[1] || width <= 0 || height <= 0 ||
+        width > 8192 || height > 8192 || s->stride <= 0 || s->slice_height <= 0 ||
+        s->crop_left < 0 || s->crop_top < 0 ||
+        (s->crop_left & 1) || (s->crop_top & 1) ||
+        info->offset < 0 || info->size < 0 ||
+        (uint64_t)info->offset + info->size > capacity ||
+        (uint64_t)s->crop_left + width > s->width ||
+        (uint64_t)s->crop_top + height > s->slice_height)
+        return AVERROR(EINVAL);
+    uvbytes = FFALIGN(width, 2) * 2;
+    if ((uint64_t)s->crop_left * 2 + uvbytes > s->stride ||
+        frame->linesize[0] < width * 2 || frame->linesize[1] < uvbytes)
+        return AVERROR(EINVAL);
+    yoff = (uint64_t)info->offset + (uint64_t)s->crop_top * s->stride + s->crop_left * 2;
+    uvoff = (uint64_t)info->offset + (uint64_t)s->slice_height * s->stride +
+        (uint64_t)(s->crop_top / 2) * s->stride + s->crop_left * 2;
+    yend = yoff + (uint64_t)(height - 1) * s->stride + width * 2;
+    uvend = uvoff + (uint64_t)((height + 1) / 2 - 1) * s->stride + uvbytes;
+    end = (uint64_t)info->offset + info->size;
+    if (yend > end || uvend > end) return AVERROR(EINVAL);
+    for (int y=0; y<height; ++y)
+        memcpy(frame->data[0] + (size_t)y*frame->linesize[0],
+               data + yoff + (size_t)y*s->stride, width*2);
+    for (int y=0; y<(height+1)/2; ++y)
+        memcpy(frame->data[1] + (size_t)y*frame->linesize[1],
+               data + uvoff + (size_t)y*s->stride, uvbytes);
+    return 0;
+}
