+
+void C2RKComponent::finishConsumedPendingWorksAtEos() {
+    std::list<std::unique_ptr<C2Work>> completed;
+    {
+        Mutexed<WorkQueue>::Locked queue(mWorkQueue);
+        if (isPendingFlushing()) return;
+        while (!queue->pending().empty()) {
+            auto it = queue->pending().begin();
+            auto work = std::move(it->second);
+            queue->pending().erase(it);
+            work->worklets.front()->output.flags = (C2FrameData::flags_t)0;
+            work->worklets.front()->output.buffers.clear();
+            work->worklets.front()->output.ordinal = work->input.ordinal;
+            work->workletsProcessed = 1u;
+            work->result = C2_OK;
+            completed.emplace_back(std::move(work));
+        }
+    }
+    if (completed.empty()) return;
+    std::shared_ptr<C2Component::Listener> listener;
+    {
+        Mutexed<ExecState>::Locked state(mExecState);
+        listener = state->mListener;
+    }
+    // Do not hold queue/state locks while calling the client. These are input
+    // ownership completions, with zero image buffers; all decoded images have
+    // already been delivered before the hardware signalled EOS.
+    c2_info("HEVC_EOS_PENDING completed=%zu after decoder EOS", completed.size());
+    listener->onWorkDone_nb(shared_from_this(), std::move(completed));
 }
 
