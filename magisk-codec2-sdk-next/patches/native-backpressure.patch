+void C2RKMpiDec::WorkHandler::schedulePoolRetry(C2RKMpiDec *decoder) {
+    const int64_t generation = mGeneration.load();
+    if (!mRunning || mRetryPending) return;
+    mRetryPending = true;
+    sp<AMessage> msg = new AMessage(kWhatPoolRetry, this);
+    msg->setPointer("thiz", decoder);
+    msg->setInt64("generation", generation);
+    msg->post(10000); // delayed, one outstanding retry; no busy polling
+}
